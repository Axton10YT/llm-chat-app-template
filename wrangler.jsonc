/**
 * Wrangler config for the Geometry Dash Private Server.
 *
 * Before deploying:
 *   1. wrangler d1 create gdps-db
 *      → copy the returned database_id into "database_id" below
 *   2. wrangler d1 execute gdps-db --file=schema.sql
 *   3. wrangler secret put ADMIN_KEY   (choose a strong password)
 *   4. wrangler deploy
 *
 * In your GD client (GDPS Switcher / LiLDiablo mod), set the server URL to:
 *   https://<your-worker>.workers.dev
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gdps",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gdps-db",
			"database_id": "YOUR_D1_DATABASE_ID_HERE"
		}
	],
	"upload_source_maps": true
}
